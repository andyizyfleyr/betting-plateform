{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "node": "22.14.0",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://be-plateform.vercel.app",
        "EXPO_PUBLIC_PARTYKIT_HOST": "pulse-bet.matiasanauld.workers.dev",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "EXPO_NO_TELEMETRY": "1"
      }
    },
    "preview": {
      "node": "22.14.0",
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://be-plateform.vercel.app",
        "EXPO_PUBLIC_UPDATES_URL": "https://be-plateform.vercel.app/api/expo",
        "EXPO_PUBLIC_UPDATES_CHANNEL": "preview",
        "EXPO_PUBLIC_PARTYKIT_HOST": "pulse-bet.matiasanauld.workers.dev",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "EXPO_NO_TELEMETRY": "1"
      }
    },
    "production": {
      "node": "22.14.0",
      "environment": "production",
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://be-plateform.vercel.app",
        "EXPO_PUBLIC_UPDATES_URL": "https://be-plateform.vercel.app/api/expo",
        "EXPO_PUBLIC_UPDATES_CHANNEL": "production",
        "EXPO_PUBLIC_PARTYKIT_HOST": "pulse-bet.matiasanauld.workers.dev",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "EXPO_NO_TELEMETRY": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
