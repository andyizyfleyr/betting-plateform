{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pulse-bet",
  "main": "party/index.ts",
  "compatibility_date": "2026-04-07",
  "vars": {
    "APP_URL": "https://be-plateform.vercel.app"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "Main",
        "class_name": "Main"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Main"
      ]
    }
  ],
  "previews": {
    "vars": {
      "APP_URL": ""
    },
    "durable_objects": {
      "bindings": [
        {
          "name": "Main",
          "class_name": "Main"
        }
      ]
    },
    "hyperdrive": []
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "b02d5785f63b4fecbbf36b45c883b4bc"
    }
  ]
}
