{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "party:dev": "wrangler dev -c wrangler.jsonc --port 1999",
    "party:deploy": "wrangler deploy -c wrangler.jsonc --autoconfig=false",
    "party:setup": "node scripts/setup-partykit.mjs",
    "ota:export": "npm --prefix mobile run export:sdk52",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p party/tsconfig.json --noEmit",
    "test:concurrency": "node scripts/test-concurrency.mjs",
    "r2:inventory": "node scripts/r2-public.cjs --dry-run",
    "r2:upload-public": "node scripts/r2-public.cjs --upload",
    "r2:verify-public-storage": "node scripts/r2-public.cjs --verify",
    "r2:verify-public": "node scripts/r2-public.cjs --verify-public"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "@vercel/functions": "^3.10.3",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.6",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "pg": "8.20.0",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@cloudflare/workers-types": "^5.20261027.1",
    "@electric-sql/pglite": "0.5.13",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.11",
    "typescript": "5.9.3",
    "wrangler": "^4.153.0"
  }
}
