# --- Base de données ---
DATABASE_URL=postgres://user:password@host:5432/db

# --- Auth JWT ---
JWT_SECRET=change-me

# --- Codes de transfert entre utilisateurs ---
# Clé dédiée aléatoire de 32 octets en hexadécimal (64 caractères), jamais partagée avec JWT.
# La conserver durablement : son changement rend les anciens codes impossibles à utiliser.
TRANSFER_CODE_SECRET=
TRANSFER_CODES_ENABLED=false

# --- Stripe (rechargement du solde) ---
# Clé secrète Stripe : sk_test_... (sandbox) ou sk_live_... (production).
# Le mode (sandbox/live) est déduit du préfixe de la clé.
STRIPE_SECRET_KEY=
# Clé webhook Stripe (créée dans le Dashboard > Webhooks > endpoint /api/payments/stripe/webhook).
STRIPE_WEBHOOK_SECRET=

# --- PayPal (rechargement du solde) ---
# Mode : "sandbox" ou "live". Le jeu de clés doit correspondre à ce mode.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# --- Scraping Playwright (1xBet / bet365) ---
# Site cible : "1xbet" | "bet365"
SCRAPE_SITE=1xbet
# URL personnalisée (outrepasse la config du site). Peut pointer vers une page locale fixture.
SCRAPE_URI=
# Nom de championnat surchargeant la config du site.
SCRAPE_LEAGUE=
# Exécution headless ("true"/"false").
SCRAPE_HEADLESS=true
# --- Cloudflare R2, médias publics (facultatif) ---
# N'activer les origines qu'après copie ET vérification des objets accessibles publiquement.
# NEXT_PUBLIC_ est intégré au build web, redéploiement nécessaire après modification.
NEXT_PUBLIC_R2_PUBLIC_ORIGIN=
# Interrupteur OTA séparé : HTTPS, origine uniquement, sans chemin ni slash final.
R2_OTA_ASSETS_ORIGIN=
# Pour scripts/r2-public.cjs uniquement : permissions limitées au bucket public.
R2_ACCOUNT_ID=
R2_PUBLIC_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Origine de vérification publique ; ne renseigner aucun secret côté client.
R2_PUBLIC_VERIFY_ORIGIN=

# Archivage privé manuel et non destructif : identifiants distincts limités à pulsebet.
# Ne jamais activer un accès public sur ce bucket. Ne pas partager ces valeurs.
R2_PRIVATE_BUCKET=
R2_PRIVATE_ACCESS_KEY_ID=
R2_PRIVATE_SECRET_ACCESS_KEY=
# 32 octets aléatoires en hexadécimal ; sauvegarde sécurisée indispensable pour restaurer.
R2_ARCHIVE_ENCRYPTION_KEY=
# Cache privé court des pages anciennes (facultatif ; requiert les clés privées ci-dessus).
R2_HISTORY_CACHE_ENABLED=false
# Active le trajet Worker Hyperdrive pour les résultats publics côté serveur (production uniquement).
HYPERDRIVE_HISTORY_ENABLED=false
